[user]
	name = David Rainsford
	email = david@rainsford.org
[init]
	defaultBranch = main
[color]
	ui = true
	branch = auto
	status = auto
[core]
	excludesfile = ~/.gitignore
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoSquash = true
	autoStash = true
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[help]
	autocorrect = prompt
[include]
	path = ~/git/dotfiles-private/git/gitconfig.local
